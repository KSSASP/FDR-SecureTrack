# FDR SecureTrack - Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=fdr_securetrack_super_secure_jwt_secret_replace_in_prod_2026
DB_PATH=./data/fdr_securetrack.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Configuration (Official GenAI SDK)
# Supported models: gemini-2.5-flash (recommended), gemini-2.0-flash, gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Simulation & Integration Adapter Configuration
ENABLE_SIMULATED_BANK_API=true
AI_PROVIDER=local_deterministic
AI_API_KEY=

# Maturity and Escalation Config
MATURITY_REMINDER_WINDOWS=90,60,30,15,7,1
ESCALATION_OVERDUE_DAYS=14
